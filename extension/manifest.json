{
  "manifest_version": 3,
  "name": "GFG → GitHub Sync",
  "version": "0.1.0",
  "description": "Save GeeksForGeeks solutions to GitHub with one click.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["https://www.geeksforgeeks.org/*", "https://api.github.com/*"],
  "action": {
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["https://www.geeksforgeeks.org/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
